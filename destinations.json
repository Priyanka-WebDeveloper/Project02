def find_destinations(trip_type, budget=None, season=None):
    # Exact match first
    matches = [d for d in DESTINATIONS if d["trip_type"] == trip_type and d["budget"] == budget and d["season"] == season]
    if matches:
        return matches

    # Fallback: match trip_type only
    fallback = [d for d in DESTINATIONS if d["trip_type"] == trip_type]
    if fallback:
        return fallback

    # Last fallback: all destinations
    return DESTINATIONS
